<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="user_mail_imap.MailDetail" owl="1">
        <section class="d-flex flex-column flex-grow-1 h-100">
            <t t-if="props.loading">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                    <i class="fa fa-spinner fa-spin fa-3x mb-3"/>
                    <p>Laddar meddelande...</p>
                </div>
            </t>
            <t t-elif="!props.message">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                    <i class="fa fa-envelope-open-o fa-4x mb-3"/>
                    <p>Välj ett meddelande</p>
                </div>
            </t>
            <t t-else="">
                <!--
                    Verktygsraden, i Thunderbirds ordning:
                    Svara · Vidarebefordra · Arkivera · Skräppost · Ta bort · Fler

                    Den satt tidigare till vänster ovanför ämnesraden. I
                    Thunderbird sitter den till HÖGER i meddelandets
                    huvud — samma placering gör det lättare att hitta utan
                    att lära om.

                    Regel-knappen sitter bredvid stjärnan i verktygsraden —
                    det är den funktion den här klienten lägger till utöver
                    Thunderbird, och den ska synas utan att man letar.
                -->
                <div class="p-3 border-bottom bg-light">
                    <div class="d-flex align-items-start gap-2">
                        <div class="flex-grow-1 min-width-0">
                            <h5 class="mb-1 text-truncate" t-out="props.message.subject"/>
                            <div class="small text-muted">
                                <strong>Från:</strong> <span t-out="props.message.from_"/><br/>
                                <strong>Till:</strong> <span t-out="props.message.to_"/><br/>
                                <t t-if="props.message.cc_">
                                    <strong>CC:</strong> <span t-out="props.message.cc_"/><br/>
                                </t>
                                <strong>Datum:</strong> <span t-out="props.message.date"/>
                            </div>
                        </div>
                        <!-- Verktygsraden, högerställd som i Thunderbird. -->
                        <div class="d-flex gap-1 flex-shrink-0">
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => props.openComposer('reply', props.message)"
                                title="Svara">
                                <i class="fa fa-reply"/>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => props.openComposer('forward', props.message)"
                                title="Vidarebefordra">
                                <i class="fa fa-mail-forward"/>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => props.onArchive(props.message)"
                                title="Arkivera">
                                <i class="fa fa-archive"/>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => props.onJunk(props.message)"
                                title="Markera som skräppost">
                                <i class="fa fa-ban"/>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => props.onDelete(props.message)"
                                title="Ta bort">
                                <i class="fa fa-trash-o"/>
                            </button>
                            <!--
                                Stjärnmärkning hör också till verktygsraden —
                                samma stjärna som i listan, så man kan
                                stjärnmärka utan att gå tillbaka.
                            -->
                            <button class="btn btn-sm"
                                t-att-class="props.message.flagged ? 'btn-warning' : 'btn-outline-secondary'"
                                t-on-click="() => props.onToggleFlag(props.message, !props.message.flagged)"
                                t-att-title="props.message.flagged ? 'Ta bort stjärnmärkning' : 'Stjärnmärk'">
                                <i class="fa" t-att-class="props.message.flagged ? 'fa-star' : 'fa-star-o'"/>
                            </button>
                            <!--
                                Etikettmeny: samma sex flaggor som i listans
                                filter, men här sätter man dem på DET HÄR
                                mailet. Ligger intill stjärnan eftersom båda
                                är "märk det här mailet"-åtgärder.

                                Listan importeras från js/mail_flags.esm.js
                                — kopierades den här skulle en etikett kunna
                                gå att sätta men inte filtrera på.
                            -->
                            <div class="dropdown">
                                <button class="btn btn-sm"
                                    t-att-class="activeFlags.length ? 'btn-info' : 'btn-outline-secondary'"
                                    data-bs-toggle="dropdown"
                                    t-att-title="activeFlags.length ? 'Etiketter: ' + activeFlags.map(flagLabel).join(', ') : 'Sätt etikett'">
                                    <i class="fa fa-tags"/>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <t t-foreach="flagOptions" t-as="opt" t-key="opt.value">
                                        <li>
                                            <button class="dropdown-item"
                                                t-on-click="() => props.onToggleFlag(props.message, opt.value, !(props.message.flags || []).includes(opt.value))">
                                                <i class="fa me-2"
                                                    t-att-class="(props.message.flags || []).includes(opt.value) ? 'fa-check-square-o text-success' : 'fa-square-o text-muted'"/>
                                                <t t-out="opt.label"/>
                                            </button>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                            <!--
                                Skapa regel från meddelandet. Ligger bredvid
                                stjärnan: båda är "märk det här mailet"-åtgärder.
                            -->
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => props.openRuleDialog(props.message)"
                                title="Skapa en regel från det här meddelandet">
                                <i class="fa fa-filter"/>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="flex-grow-1 overflow-auto p-3">
                    <!--
                        sandbox: the mail body is untrusted HTML. Without it the
                        iframe inherits allow-scripts and a message could run
                        scripts in the application context. allow-same-origin
                        keeps inline images working; allow-popups lets links
                        open a new window. Deliberately NOT allow-scripts and
                        NOT allow-top-navigation: a message must not execute
                        code or navigate the application away.
                    -->
                    <iframe class="w-100 h-100 border-0"
                        sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
                        t-on-load="onIframeLoad"
                        t-att-srcdoc="props.message.body_html"/>
                </div>
                <!--
                    Kalenderinbjudan. Visas bara när meddelandet faktiskt
                    innehåller en — annars hade varje mail fått en rad som
                    säger "ingen inbjudan".

                    Acceptera lägger in mötet i kalendern OCH skickar
                    svaret till organisatören. Att bara svara hade lämnat
                    användaren utan möte; att bara lägga in det hade lämnat
                    organisatören ovetande.
                -->
                <div class="p-3 border-top bg-primary-subtle" t-if="invitation">
                    <div class="d-flex align-items-start gap-3">
                        <i class="fa fa-calendar-check-o fa-2x text-primary mt-1"/>
                        <div class="flex-grow-1">
                            <div class="fw-bold" t-out="invitation.summary"/>
                            <div class="small text-muted">
                                <t t-out="invitation.startLabel"/>
                                <t t-if="invitation.location">
                                    · <t t-out="invitation.location"/>
                                </t>
                                <t t-if="invitation.organizer_email">
                                    · <t t-out="invitation.organizer_email"/>
                                </t>
                            </div>
                            <div class="small mt-1" t-if="invitation.in_calendar">
                                <i class="fa fa-check text-success me-1"/>
                                Inlagd i kalendern
                                <t t-if="invitation.partstatLabel">
                                    — <t t-out="invitation.partstatLabel"/>
                                </t>
                            </div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                            <button class="btn btn-sm btn-success"
                                t-on-click="() => this.respondInvitation('accept')"
                                t-att-disabled="responding">
                                <i class="fa fa-check me-1"/>Acceptera
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                t-on-click="() => this.respondInvitation('tentative')"
                                t-att-disabled="responding">
                                Preliminärt
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                t-on-click="() => this.respondInvitation('decline')"
                                t-att-disabled="responding">
                                <i class="fa fa-times me-1"/>Avböj
                            </button>
                        </div>
                    </div>
                </div>

                <!--
                    Bilagor. Länken går direkt mot /imap/attachment som
                    svarar med Content-Disposition: attachment — webbläsaren
                    sköter nedladdningen, ingen blob behöver byggas i
                    klienten. Indexet, inte namnet, identifierar bilagan:
                    två filer kan heta samma sak.
                -->
                <t t-if="props.message.attachments &amp;&amp; props.message.attachments.length">
                    <div class="p-3 border-top bg-light">
                        <div class="text-muted small mb-2">
                            <i class="fa fa-paperclip me-1"/>
                            <t t-out="props.message.attachments.length"/> bilaga(or)
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a t-foreach="props.message.attachments" t-as="att" t-key="att_index"
                                class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-2"
                                t-att-href="attachmentUrl(att, att_index)"
                                t-att-title="'Ladda ned ' + att.filename"
                                download="">
                                <i class="fa fa-download"/>
                                <span class="text-truncate" style="max-width: 220px;" t-out="att.filename"/>
                            </a>
                        </div>
                    </div>
                </t>
            </t>
        </section>
    </t>
</templates>
