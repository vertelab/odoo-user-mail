<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="user_mail_imap.SieveRuleDialog" owl="1">
        <Dialog title="'Skapa regel'" size="'md'">
            <div class="p-3">
                <p class="text-muted small mb-3" t-if="props.message">
                    Regeln skapas från meddelandet
                    <strong t-out="props.message.subject"/>.
                </p>

                <div class="alert alert-danger" role="alert"
                    t-if="state.error" t-out="state.error"/>

                <!-- Namn: förifyllt förslag, redigerbart. -->
                <div class="mb-3">
                    <label class="form-label" for="rule-name">Namn</label>
                    <input id="rule-name" type="text" class="form-control"
                        t-model="state.name"
                        t-att-placeholder="suggestedName()"/>
                    <div class="form-text">
                        Föreslås från villkoret. Ändra fritt.
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label" for="rule-kind">Matcha på</label>
                        <select id="rule-kind" class="form-select"
                            t-on-change="(ev) => this.onConditionKindChange(ev.target.value)"
                            t-att-value="state.conditionKind">
                            <option value="sender">Avsändare</option>
                            <option value="subject">Ämne</option>
                            <option value="header">Valfri header</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="rule-text">
                            <t t-if="state.conditionKind === 'sender'">Avsändare</t>
                            <t t-elif="state.conditionKind === 'subject'">Ämne</t>
                            <t t-else="">Värde</t>
                        </label>
                        <input id="rule-text" type="text" class="form-control"
                            t-att-value="state.conditionText"
                            t-on-input="(ev) => this.onConditionTextChange(ev.target.value)"
                            t-att-placeholder="state.conditionKind === 'sender' ? 'namn@domän.se' : (state.conditionKind === 'subject' ? 'Text i ämnesraden' : 'Värdet att matcha')"/>
                    </div>
                </div>

                <!--
                    Header-väljaren visas bara för "Valfri header".
                    Datum- och listningsheaders är de vanligaste skälen att
                    matcha på annat än avsändare: X-Spam-Flag fångar
                    skräppost, List-Id fångar utskick.
                -->
                <!--
                    Header-väljaren. Listan kommer från meddelandets EGNA
                    headers, inte från en påhittad lista: att skriva
                    "X-Spam-Flag" ur minnet när mailet har
                    "X-Spam-flag" ger en regel som aldrig matchar, och
                    användaren har ingen chans att se varför.

                    Värdet förifylls när headern väljs — det är hela
                    poängen med att läsa dem.
                -->
                <div class="mb-3" t-if="needsHeader">
                    <label class="form-label" for="rule-header">Header</label>
                    <t t-if="availableHeaders.length">
                        <select id="rule-header" class="form-select"
                            t-on-change="(ev) => this.onHeaderSelect(ev.target.value)">
                            <option value="">— välj header —</option>
                            <t t-foreach="availableHeaders" t-as="h" t-key="h.name">
                                <option t-att-value="h.name"
                                    t-att-selected="state.conditionHeader === h.name">
                                    <t t-out="h.name"/>
                                    <t t-if="h.value"> — <t t-out="h.value"/></t>
                                </option>
                            </t>
                        </select>
                    </t>
                    <input t-else="" id="rule-header" type="text" class="form-control"
                        t-att-value="state.conditionHeader"
                        t-on-input="(ev) => this.onHeaderChange(ev.target.value)"
                        placeholder="X-Spam-Flag"/>
                    <div class="form-text">
                        <t t-if="availableHeaders.length">
                            Headers som finns i det valda meddelandet.
                        </t>
                        <t t-else="">
                            Meddelandets headers kunde inte läsas — skriv
                            headernamnet själv.
                        </t>
                        Matchar om headern <em>innehåller</em> värdet.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="rule-action">Åtgärd</label>
                    <select id="rule-action" class="form-select"
                        t-model="state.action">
                        <option value="move_to_folder">Flytta till mapp</option>
                        <option value="flag">Flagga</option>
                        <option value="ignore">Ignorera</option>
                        <option value="block">Blockera</option>
                    </select>
                    <!--
                        Förklaring per åtgärd. "Ignorera" och "Blockera"
                        låter lika men gör olika saker, och skillnaden syns
                        inte i namnet — den som väljer fel får antingen
                        tysta mail eller avvisade mail.
                    -->
                    <div class="form-text">
                        <t t-if="state.action === 'move_to_folder'">
                            Mailet flyttas till mappen vid leverans och syns
                            aldrig i inkorgen.
                        </t>
                        <t t-elif="state.action === 'flag'">
                            Mailet ligger kvar men märks, så du kan filtrera
                            fram det.
                        </t>
                        <t t-elif="state.action === 'ignore'">
                            <strong>Ignorera</strong> — mailet tas bort vid
                            leverans utan att du ser det. Avsändaren får
                            inget besked och mailet går inte att få tillbaka.
                        </t>
                        <t t-elif="state.action === 'block'">
                            <strong>Blockera</strong> — mailet avvisas med
                            ett fel till avsändaren, som får veta att det
                            inte levererats. Använd när du vill att
                            avsändaren ska sluta skicka, inte bara att du
                            ska slippa se det.
                        </t>
                    </div>
                </div>

                <!--
                    Flaggtyp. Standardflaggor syns i alla klienter;
                    todo/personal/work är IMAP-nyckelord som Thunderbird
                    visar men andra klienter kan hoppa över.
                -->
                <div class="mb-3" t-if="needsFlag">
                    <label class="form-label" for="rule-flag">Flaggtyp</label>
                    <select id="rule-flag" class="form-select"
                        t-model="state.flagKind">
                        <option value="flagged">Stjärnmärk</option>
                        <option value="spam">Skräppost</option>
                        <option value="important">Viktig</option>
                        <option value="todo">Att göra</option>
                        <option value="personal">Privat</option>
                        <option value="work">Arbete</option>
                    </select>
                    <div class="form-text">
                        Att göra / Privat / Arbete sätter IMAP-nyckelord —
                        syns i Thunderbird, men inte i alla klienter.
                    </div>
                </div>

                <div class="mb-3" t-if="needsFolder">
                    <label class="form-label" for="rule-folder">Mapp</label>
                    <select id="rule-folder" class="form-select"
                        t-if="state.folders.length" t-model="state.folder">
                        <option value="">— välj mapp —</option>
                        <t t-foreach="state.folders" t-as="f" t-key="f">
                            <option t-att-value="f" t-out="f"/>
                        </t>
                    </select>
                    <input t-else="" type="text" class="form-control"
                        t-model="state.folder" placeholder="Mappnamn"/>

                    <!--
                        Ny mapp. Sieve:s fileinto :create skapar mappen vid
                        leverans, men först när ett mail matchar — att skapa
                        den här ger omedelbar bekräftelse på att namnet är
                        giltigt, och mappen syns i trädet direkt.
                    -->
                    <div class="input-group input-group-sm mt-2">
                        <input type="text" class="form-control"
                            t-model="state.newFolder"
                            placeholder="Ny mapp, t.ex. INBOX.Kvitton"
                            t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.onCreateFolder()"/>
                        <button class="btn btn-outline-secondary" type="button"
                            t-on-click="() => this.onCreateFolder()"
                            t-att-disabled="state.creatingFolder || !state.newFolder.trim()">
                            <i class="fa fa-spinner fa-spin me-1" t-if="state.creatingFolder"/>
                            <i class="fa fa-plus me-1" t-else=""/>
                            Skapa mapp
                        </button>
                    </div>
                    <div class="form-text">
                        Mappen skapas på mejlservern. Använd punkt som
                        avgränsare: <code>INBOX.Kvitton</code>.
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label" for="rule-enforcement">Körs</label>
                    <select id="rule-enforcement" class="form-select"
                        t-on-change="(ev) => this.onEnforcementChange(ev.target.value)"
                        t-att-value="state.enforcement">
                        <option value="server">På servern (vid leverans)</option>
                        <option value="client">I Odoo (efter hämtning)</option>
                    </select>
                    <div class="form-text">
                        <t t-if="state.enforcement === 'server'">
                            Körs av mejlservern innan Odoo ser mailet.
                            Villkor: avsändare, ämne eller valfri header.
                        </t>
                        <t t-else="">
                            Körs när mailet hämtats. Kan använda AI och skapa
                            Odoo-objekt, men hindrar inte mailet från att
                            först hamna i inkorgen.
                        </t>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">
                    Avbryt
                </button>
                <button class="btn btn-primary" t-on-click="onConfirm"
                    t-att-disabled="state.saving">
                    <i class="fa fa-spinner fa-spin me-1" t-if="state.saving"/>
                    Skapa regel
                </button>
            </t>
        </Dialog>
    </t>
</templates>
