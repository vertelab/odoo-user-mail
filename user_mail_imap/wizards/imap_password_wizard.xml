<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_imap_password_wizard" model="ir.actions.act_window">
        <field name="name">Ange mail-lösenord</field>
        <field name="res_model">user.mail.imap.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_imap_password_wizard_form" model="ir.ui.view">
        <field name="name">user.mail.imap.password.wizard.form</field>
        <field name="model">user.mail.imap.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Ange mail-lösenord">
                <group>
                    <field name="password" placeholder="Ditt mail-lösenord"/>
                </group>
                <p class="text-muted">
                    Samma lösenord som du loggar in i Odoo med. Det verifieras
                    mot din brevlåda innan det sparas.
                </p>
                <footer>
                    <button name="action_save" type="object"
                            string="Spara" class="btn-primary"/>
                    <button string="Avbryt" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
