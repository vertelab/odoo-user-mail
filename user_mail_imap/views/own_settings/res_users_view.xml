<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Fristående E-postinställningar (user_mail_client) — lösenords-
            och pollsektionen.

            VARFÖR EN EGEN KATALOG "own_settings":
            Den här vyn ärver user_mail_client.view_user_mail_own_settings_form.
            Det gör den till den ENDA platsen i user_mail_imap som refererar
            en xmlid från user_mail_client. Ligger den kvar i
            views/res_users_view.xml (som bara handlar om Min profil) blir
            referensen ett osynligt beroende mitt i en annars oberoende modul,
            och ett test som vill verifiera att den nya formen inte ärver
            base.view_users_form_simple_modif matchar fel vyer.

            Här är det däremot synligt och avgränsat: en katalog som heter
            exakt det ytan heter.

            VARFÖR INGET depends = user_mail_client:
            Beroenderiktningen ska vara client -> common, imap -> common.
            Ett imap -> client hade vänt på den och gjort IMAP-klienten
            oanvändbar utan e-postinställningsformuläret. Båda modulerna
            installeras tillsammans, och xmlid-referensen löses vid
            installationstillfället; saknas vyn får användaren ett tydligt
            fel i loggen i stället för en tyst trasig vy.
        -->
        <record id="view_user_mail_own_settings_form_imap" model="ir.ui.view">
            <field name="name">res.users.mail.own.settings.form.imap</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="user_mail_client.view_user_mail_own_settings_form"/>
            <field name="arch" type="xml">
                <div name="mail_credentials_anchor" position="inside">
                    <group name="mail_assistant" string="Mail-hjälpredan">
                        <div colspan="2">
                            <!-- Lösenordet sätts via wizarden och visas aldrig
                                 tillbaka i klartext. Fältet läses bara för att
                                 kunna visa om ett lösenord finns —
                                 imap_password är write-only i praktiken. -->
                            <field name="imap_password" invisible="1"/>
                            <button name="%(action_imap_password_wizard)d"
                                    type="action"
                                    string="Ange mail-lösenord"
                                    class="btn btn-secondary"/>
                            <span class="text-muted ms-2" invisible="imap_password">
                                Inget lösenord angett — pollning är avstängd.
                            </span>
                            <span class="text-muted ms-2" invisible="not imap_password">
                                Lösenord angett.
                            </span>
                        </div>
                        <field name="imap_poll_enabled"
                               readonly="not imap_password"/>
                        <field name="last_imap_sync" readonly="1"/>
                    </group>
                </div>
            </field>
        </record>

    </data>
</odoo>
