<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Integritet: personlig mail är privat — ägaren ser bara sina egna
         triage-poster. Admin (sudo) går förbi regeln. -->
    <!-- ir.rule is gone in 20.0, merged into ir.access.domain. Owner-only,
         same domain and the same operations: cru (unlink was False). -->
    <record id="user_mail_ai_mail_owner_rule" model="ir.access">
        <field name="name">user_mail_ai.mail: ägare ser egna</field>
        <field name="model_id" ref="model_user_mail_ai_mail"/>
        <field name="domain">[('user_id', '=', user.id)]</field>
        <field name="group_id" ref="base.group_user"/>
        <field name="operation">cru</field>
    </record>
</odoo>
