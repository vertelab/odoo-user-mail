<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Profil-status + digest-inställningar i Min profil -->
    <record id="view_res_users_form_inherit_mail_ai" model="ir.ui.view">
        <field name="name">res.users.form.inherit.mail.ai</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_mail_rules" type="object"
                        class="oe_stat_button" icon="fa-sliders">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Mail-regler</span>
                    </div>
                </button>
            </div>
            <xpath expr="//sheet" position="inside">
                <group string="Mail-hjälpredan (Skiva 3)">
                    <field name="ai_digest_enabled"/>
                    <field name="ai_digest_weekday"
                           invisible="ai_digest_enabled == False"/>
                    <field name="ai_profile_weekday"/>
                    <field name="ai_profile_updated" readonly="1"/>
                    <field name="ai_profile_text" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Min profil (preferences-dialogen): minnessynk-knappen.
         Samma kärna som cronen, scopad till env.user (Q-D). -->
    <record id="view_users_simple_modif_mail_memory" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mail.memory</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <page name="preferences_page" position="inside">
                <group name="mail_memory" string="Mail-minne">
                    <div colspan="2">
                        <button name="action_refresh_mail_memory"
                                type="object"
                                string="Uppdatera mina mail-minnen"
                                class="btn btn-secondary"/>
                        <span class="text-muted ms-2">
                            Bygger OKF + graf för mina ännu ej indexerade mail.
                        </span>
                    </div>
                </group>
            </page>
        </field>
    </record>
</odoo>
