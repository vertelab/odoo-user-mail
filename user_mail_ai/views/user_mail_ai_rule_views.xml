<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="user_mail_ai_rule_search" model="ir.ui.view">
        <field name="name">user.mail.ai.rule.search</field>
        <field name="model">user_mail_ai.rule</field>
        <field name="arch" type="xml">
            <search string="Mail-regler">
                <field name="name"/>
                <field name="condition_text"/>
                <field name="action"/>
                <!-- Seed-reglerna 4-7 skapas inaktiva (provläge). Utan
                     detta filter går de inte att hitta i listan — den
                     döljer inaktiva poster. "Inaktiva" visar dem så de
                     kan aktiveras manuellt. -->
                <filter name="inactive" string="Inaktiva"
                        domain="[('active', '=', False)]"/>
                <filter name="active" string="Aktiva"
                        domain="[('active', '=', True)]"/>
                <separator/>
                <filter name="seed" string="Standardregler"
                        domain="[('source', '=', 'seed')]"/>
                <filter name="own" string="Egna"
                        domain="[('source', '!=', 'seed')]"/>
                <group expand="0" string="Gruppera">
                    <filter name="g_active" string="Aktiv"
                            domain="[]" context="{'group_by': 'active'}"/>
                    <filter name="g_source" string="Källa"
                            domain="[]" context="{'group_by': 'source'}"/>
                    <filter name="g_action" string="Åtgärd"
                            domain="[]" context="{'group_by': 'action'}"/>
                    <filter name="g_condition_kind" string="Villkorstyp"
                            domain="[]"
                            context="{'group_by': 'condition_kind'}"/>
                    <filter name="g_priority" string="Prioritet"
                            domain="[]" context="{'group_by': 'priority'}"/>
                    <filter name="g_user" string="Användare"
                            domain="[]" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="user_mail_ai_rule_list" model="ir.ui.view">
        <field name="name">user.mail.ai.rule.list</field>
        <field name="model">user_mail_ai.rule</field>
        <field name="arch" type="xml">
            <list string="Mail-hjälpredan — regler">
                <field name="priority"/>
                <field name="name"/>
                <field name="condition_kind"/>
                <field name="condition_text"/>
                <field name="action"/>
                <field name="source"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="user_mail_ai_rule_form" model="ir.ui.view">
        <field name="name">user.mail.ai.rule.form</field>
        <field name="model">user_mail_ai.rule</field>
        <field name="arch" type="xml">
            <form string="Mail-regel">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="priority"/>
                            <field name="active"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group>
                            <field name="condition_kind"/>
                            <field name="condition_text"/>
                            <field name="action"/>
                            <field name="action_config"/>
                        </group>
                    </group>
                    <group>
                        <field name="enforcement"/>
                    </group>
                    <!--
                        Förklara skillnaden där valet görs, inte i en
                        tooltip. Användaren ska inte behöva veta vad Sieve
                        är för att välja rätt.
                    -->
                    <div class="alert alert-info" colspan="2" role="status">
                        <strong>I Odoo</strong> — regeln körs när mailet hämtats.
                        Kan använda AI, skapa Odoo-objekt och skicka svar, men
                        hindrar inte mailet från att först hamna i inkorgen.
                        <br/>
                        <strong>På servern</strong> — regeln körs av
                        mejlservern vid leverans, innan Odoo ser mailet. Bara
                        avsändare och ämne som villkor, och bara flytta,
                        flagga eller kasta som åtgärd.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="user_mail_ai_rule_action" model="ir.actions.act_window">
        <field name="name">Mail-hjälpredan — regler</field>
        <field name="res_model">user_mail_ai.rule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <!-- Standard: visa ALLA regler, även inaktiva. Annars ser man bara
             tre av sju och tror att seed-reglerna saknas. `active_test`
             stänger av ORM:ens automatiska active-filter för vyn. -->
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- E-postregler — EN lista för BÅDA enforcement-lägena.

         Det finns bara en modell, user_mail_ai.rule. `enforcement` avgör var
         regeln körs (client = i Odoo efter hämtning, server = kompilerad till
         Sieve vid leverans), inte vilken sorts regel det är. Vyn har medvetet
         inget enforcement-filter — att filtrera här var det som fick det att
         se ut som två regelsystem.

         Ligger under Odoos Discuss → Konfiguration, efter E-postinställningar
         (sequence 20). -->
    <menuitem id="menu_user_mail_ai_rules"
        name="E-postregler"
        parent="mail.menu_configuration"
        action="user_mail_ai_rule_action"
        sequence="30"
        groups="user_mail_common.group_own_email_settings"/>

</odoo>
