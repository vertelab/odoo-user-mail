<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Vacation → Sieve, dagligen.

            Varför cron och inte datumvillkor i Sieve: `currentdate` med
            :value kräver require ["relational"] och lämnar ändå ett block
            kvar efter perioden. Cron ger EN sanning (vacation_active +
            datumen) och kan testas i Python.

            Varför dagligen och inte oftare: vacation är inte
            sekundkänsligt. Ett byte mitt på dagen fångas av write()-hooken
            på res.users, så cron behövs bara för DATUMGRÄNSERNA — att slå
            på vid from och av vid to.
        -->
        <record id="ir_actions_server_sieve_vacation" model="ir.actions.server">
            <field name="name">Sieve: semesterautosvar</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._cron_sieve_vacation()</field>
        </record>

        <record id="cron_sieve_vacation" model="ir.cron">
            <field name="name">Sieve: semesterautosvar (dagligen)</field>
            <field name="cron_name">Sieve: semesterautosvar (dagligen)</field>
            <field name="ir_actions_server_id" ref="ir_actions_server_sieve_vacation"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
