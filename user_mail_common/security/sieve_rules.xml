<?xml version="1.0"?>
<odoo>
    <data noupdate="1">

        <!--
            En användare får bara se och röra sitt EGET sieve-script.
            Utan denna regel skulle group_own_email_settings (som alla
            användare med e-postinställningar har) ge läsrätt på alla
            användares genererade script — inklusive deras vacation-text.

            base.group_erp_manager har ingen regel och ser därför allt.
        -->
        <record model="ir.rule" id="sieve_script_own_rule">
            <field name="name">sieve.script: endast eget script</field>
            <field name="model_id" ref="model_sieve_script"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('user_mail_common.group_own_email_settings'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
