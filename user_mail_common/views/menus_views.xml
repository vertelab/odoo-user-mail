<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Rotmenyn "Inställningar" under Discuss.

            Ligger i user_mail_common därför att BÅDA grenarna hänger sina
            poster här:
                user_mail_client  → E-postkonfiguration
                user_mail_ai      → Regler

            user_mail_ai beror INTE på user_mail_client (och tvärtom), så
            ingen av dem kan äga roten. Basmodulen kan.

            Namnet "Inställningar" kolliderar med Odoos egen
            mail.menu_configuration ("Configuration" → "Inställningar" på
            svenska). Vi lägger oss efter den (sequence 90) och håller våra
            poster separerade — vi skriver inte i Odoos meny.
        -->
        <menuitem id="menu_user_mail_settings"
            name="Inställningar"
            parent="mail.menu_root_discuss"
            sequence="90"
            groups="user_mail_common.group_own_email_settings"/>

    </data>
</odoo>
