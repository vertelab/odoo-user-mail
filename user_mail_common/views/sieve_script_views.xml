<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Scriptvyn — det genererade Sieve-scriptet, skrivskyddat.

            Poängen är inte att användaren ska redigera koden (den byggs om
            vid varje regeländring och skulle skrivas över), utan att göra
            ETT misslyckande synligt. När synken fallerar sätts state='error'
            och last_error — utan den här vyn hamnar det felet bara i
            loggen, och användaren tror att reglerna är aktiva på servern
            när de inte är det.
        -->
        <record id="sieve_script_form" model="ir.ui.view">
            <field name="name">sieve.script.form</field>
            <field name="model">sieve.script</field>
            <field name="arch" type="xml">
                <form string="Sieve-script" create="0" delete="0">
                    <header>
                        <button name="action_sync" type="object"
                            string="Synka nu" class="btn-primary"
                            help="Ladda upp scriptet till mejlservern igen."/>
                        <button name="action_pull_from_server" type="object"
                            string="Hämta från servern"
                            help="Läs in scriptet som ligger på servern. Skriver över den lokala kopian."/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,synced,error"/>
                    </header>
                    <sheet>
                        <div class="alert alert-danger" role="alert"
                            invisible="state != 'error'">
                            <strong>Scriptet ligger inte på servern.</strong>
                            Reglerna körs alltså inte. Felet var:
                            <field name="last_error" nolabel="1"
                                class="mt-2 font-monospace small"/>
                        </div>
                        <div class="alert alert-info" role="status"
                            invisible="state != 'synced'">
                            Scriptet är uppladdat och aktivt på mejlservern.
                        </div>
                        <group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="name" readonly="1"/>
                            </group>
                            <group>
                                <field name="last_sync" readonly="1"/>
                                <field name="is_active_on_server" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Genererad kod"/>
                        <p class="text-muted small">
                            Byggs om automatiskt när en regel eller
                            semesterautosvaret ändras. Redigeras inte för hand —
                            ändringen skulle skrivas över vid nästa synk.
                        </p>
                        <field name="body" readonly="1" widget="ace"
                            options="{'mode': 'text'}"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="sieve_script_list" model="ir.ui.view">
            <field name="name">sieve.script.list</field>
            <field name="model">sieve.script</field>
            <field name="arch" type="xml">
                <list string="Sieve-script" create="0" delete="0">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'synced'"
                        decoration-danger="state == 'error'"
                        decoration-muted="state == 'draft'"/>
                    <field name="last_sync"/>
                    <field name="is_active_on_server"/>
                </list>
            </field>
        </record>

        <record id="sieve_script_action" model="ir.actions.act_window">
            <field name="name">Sieve-script</field>
            <field name="res_model">sieve.script</field>
            <field name="view_mode">list,form</field>
            <!-- Bara användarens eget script. Hanteraren ser alla via
                 erp_manager-regeln i ir.model.access.csv. -->
            <field name="domain">[('user_id', '=', uid)]</field>
        </record>

        <!--
            Ingen meny för sieve.script.

            Vyn är inte en regellista — den är det GENERERADE scriptet med
            synkstatus och senaste fel. Att lägga den bredvid E-postregler
            var det som fick det att se ut som två regelsystem.

            Den nås i stället via knappen "Sieve-status" på
            E-postinställningar (se res_users_view.xml), där frågan "körs
            mina regler verkligen?" faktiskt ställs. Vyn och action finns
            kvar — bara menyposten är borta.
        -->

    </data>
</odoo>
