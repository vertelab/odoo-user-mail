<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- KANBAN VIEW — alla användare som kort, grupperade på kund -->
    <!-- ================================================================== -->
    <record id="view_scim_directory_kanban" model="ir.ui.view">
        <field name="name">scim.directory.user.kanban</field>
        <field name="model">scim.directory.user</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="display_name" />
                <field name="email_primary" />
                <field name="customer" />
                <field name="matrix_id" />
                <field name="active_scim" />
                <field name="forward_active" />
                <field name="quota" />
                <field name="phone_number" />
                <field name="image_128" />

                <templates>
                    <t t-name="card" class="flex-row">
                        <!-- Avatar / placeholder -->
                        <aside class="o_kanban_aside_full">
                            <t t-if="record.image_128.raw_value">
                                <field name="image_128" widget="image"
                                       class="d-block o_image_cover o_image_64_cover" />
                            </t>
                            <t t-else="">
                                <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient h-100"
                                     style="min-height: 80px;">
                                    <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <g fill="currentColor">
                                            <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                            <circle cx="10" cy="5.5" r="4.5"/>
                                        </g>
                                    </svg>
                                </div>
                            </t>
                        </aside>

                        <!-- Main content -->
                        <main class="ms-2 w-100"
                              t-attf-class="oe_kanban_card oe_kanban_global_click oe_kanban_color_#{record.active_scim.raw_value ? '0' : '7'} ms-2">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fw-bold fs-5">
                                        <field name="display_name" />
                                    </strong>
                                </div>
                            </div>

                            <!-- Email -->
                            <div t-if="record.email_primary.raw_value" class="o_text_overflow">
                                <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                                <field name="email_primary" />
                            </div>

                            <!-- Badges row -->
                            <div class="d-flex flex-wrap gap-1 my-1">
                                <t t-if="record.active_scim.raw_value">
                                    <span class="badge badge-success">Active</span>
                                </t>
                                <t t-else="">
                                    <span class="badge badge-danger">Inactive</span>
                                </t>
                                <t t-if="record.matrix_id.raw_value">
                                    <span class="badge o_kanban_badge">
                                        <i class="fa fa-hashtag"/> Matrix
                                    </span>
                                </t>
                                <t t-if="record.forward_active.raw_value">
                                    <span class="badge badge-info">
                                        <i class="fa fa-share"/> Forward
                                    </span>
                                </t>
                            </div>

                            <!-- Customer & Quota row -->
                            <div class="d-flex justify-content-between align-items-center w-100 mt-1">
                                <div class="o_text_overflow text-muted">
                                    <i class="fa fa-building-o"/>
                                    <field name="customer" />
                                </div>
                                <small class="text-muted text-nowrap">
                                    <i class="fa fa-database"/>
                                    <field name="quota" /> MB
                                </small>
                            </div>

                            <!-- Phone (optional) -->
                            <div t-if="record.phone_number.raw_value" class="o_text_overflow text-muted small">
                                <i class="fa fa-fw me-1 fa-phone"/>
                                <field name="phone_number" />
                            </div>

                            <!-- Footer -->
                            <footer class="mt-2">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <span class="small text-muted">
                                        <i class="fa fa-hashtag" style="color: #0dbd8b;"/>
                                        <field name="matrix_id" t-if="record.matrix_id.raw_value" />
                                    </span>
                                    <field name="activity_ids" widget="kanban_activity" class="ms-2"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
