<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- KANBAN VIEW — alla användare som kort, grupperade på kund -->
    <!-- ================================================================== -->
    <record id="view_scim_directory_kanban" model="ir.ui.view">
        <field name="name">scim.directory.user.kanban</field>
        <field name="model">scim.directory.user</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="display_name" />
                <field name="email_primary" />
                <field name="customer" />
                <field name="matrix_id" />
                <field name="active_scim" />
                <field name="forward_active" />
                <field name="quota" />
                <field name="phone_number" />

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click"
                             t-att-class="'oe_kanban_color_0' if record.active_scim.raw_value else 'oe_kanban_color_7'">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name" />
                                        </strong>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="email_primary" />
                                        </span>
                                    </div>
                                </div>
                                <span class="o_kanban_badge"
                                      t-if="record.matrix_id.raw_value">
                                    <i class="fa fa-hashtag"/> Matrix
                                </span>
                            </div>

                            <div class="oe_kanban_details">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="o_kanban_record_bottom">
                                            <i class="fa fa-building-o"/>
                                            <field name="customer" />
                                        </div>
                                    </div>
                                    <div class="col-6 text-right">
                                        <t t-if="record.active_scim.raw_value">
                                            <span class="badge badge-success">Active</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge badge-danger">Inactive</span>
                                        </t>
                                    </div>
                                </div>

                                <div class="row mt-1">
                                    <div class="col-6">
                                        <t t-if="record.forward_active.raw_value">
                                            <span class="badge badge-info">
                                                <i class="fa fa-share"/> Forward
                                            </span>
                                        </t>
                                    </div>
                                    <div class="col-6 text-right">
                                        <small class="text-muted">
                                            <i class="fa fa-database"/>
                                            <field name="quota" /> MB
                                        </small>
                                    </div>
                                </div>

                                <div class="row mt-1" t-if="record.phone_number.raw_value">
                                    <div class="col-12">
                                        <i class="fa fa-phone"/>
                                        <field name="phone_number" />
                                    </div>
                                </div>

                                <div class="row mt-1" t-if="record.matrix_id.raw_value">
                                    <div class="col-12">
                                        <i class="fa fa-hashtag" style="color: #0dbd8b;"/>
                                        <field name="matrix_id" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
