        <record id="view_service_partner_form" model="ir.ui.view">
            <field name="name">res.partner.service.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field eval="50" name="priority"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page groups="base.group_erp_manager" name="service" string="Service">
                        <field colspan="4" groups="base.group_erp_manager" name="service_ids" nolabel="1" widget="one2many_list">
                            <tree string="Service">
                                <field name="state"/>
                                <field name="service_id"/>
                                <button icon="terp-mail-message-new" name="%(mail.action_email_compose_message_wizard)d" string="Send Email" type="action"/>
                                <button class="oe_highlight" icon="terp-mail-" name="open_mailform" string="Send mail" type="object"/>
                                <button class="oe_highlight" icon="gtk-edit" invisible="state not in ['sent']" name="edit_passwd" string="Edit password" type="object"/>
                                <button class="oe_highlight" icon="gtk-delete" invisible="state not in ['sent']" name="cancel_passwd" string="Cancel password" type="object"/>
                                <button class="oe_highlight" icon="gtk-refresh" invisible="state not in ['draft']" name="generate_passwd" string="Generate password" type="object"/>
                            </tree>
                            <form string="Service">
                                <field name="state"/>
                                <field name="service_id"/>
                                <!--
                              <field name="server_ids" widget="many2many_tags"/>
-->
                                <field name="apache_site"/>
                                <field name="bind_record"/>
                                <field name="odoo_database"/>
                                <field name="odoo_nbrusers"/>
                            </form></field>
                    </page>
                </notebook></field>
        </record>
    </data>
</odoo>
