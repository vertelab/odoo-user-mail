<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <!-- Testdata: lektioner i kursen "E-post i Vertel".
         Laddas ENDAST mot *_test-databaser (repo_apply: –without-demo=all
         för produktion). Ersätts av riktigt innehåll i Fas 5. -->
    <record id="slide_user_mail_0" model="slide.slide">
        <field name="name">Kom igång med e-post</field>
        <field name="channel_id" ref="slide_channel_user_mail"/>
        <field name="slide_category">article</field>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;Översikt: vad e-postklienten gör och hur den skiljer sig från en vanlig mailklient.&lt;/p&gt;</field>
        <field name="sequence">10</field>
    </record>
    <record id="slide_user_mail_1" model="slide.slide">
        <field name="name">Koppla upp ditt konto</field>
        <field name="channel_id" ref="slide_channel_user_mail"/>
        <field name="slide_category">article</field>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;IMAP/SMTP-inställningar, lösenord, tvåfaktorsautentisering.&lt;/p&gt;</field>
        <field name="sequence">20</field>
    </record>
    <record id="slide_user_mail_2" model="slide.slide">
        <field name="name">Läsa och skicka</field>
        <field name="channel_id" ref="slide_channel_user_mail"/>
        <field name="slide_category">article</field>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;Inkorgen, mappar, bilagor, svar och vidarebefordran.&lt;/p&gt;</field>
        <field name="sequence">30</field>
    </record>
    <record id="slide_user_mail_3" model="slide.slide">
        <field name="name">AI i inkorgen</field>
        <field name="channel_id" ref="slide_channel_user_mail"/>
        <field name="slide_category">article</field>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;Sammanfatta trådar, föreslå svar, hitta avtal och bilagor.&lt;/p&gt;</field>
        <field name="sequence">40</field>
    </record>

</data></odoo>
