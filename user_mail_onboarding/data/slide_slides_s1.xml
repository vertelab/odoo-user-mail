    <record id="slide_mail_s1_04_q1" model="slide.question">
        <field name="question">Vilket protokoll hämtar din inkommande e-post?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_mail_s1_04"/>
    </record>
    <record id="slide_mail_s1_04_q1_a1" model="slide.answer">
        <field name="text_value">SMTP</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — SMTP skickar utgående post.</field>
        <field name="question_id" ref="slide_mail_s1_04_q1"/>
    </record>
    <record id="slide_mail_s1_04_q1_a2" model="slide.answer">
        <field name="text_value">IMAP</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! IMAP hämtar inkommande och låter meddelandena ligga kvar på servern.</field>
        <field name="question_id" ref="slide_mail_s1_04_q1"/>
    </record>
    <record id="slide_mail_s1_04_q1_a3" model="slide.answer">
        <field name="text_value">POP3</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — POP3 är det äldre protokollet som laddar ner och tar bort. Vi använder IMAP.</field>
        <field name="question_id" ref="slide_mail_s1_04_q1"/>
    </record>

    <record id="slide_mail_s1_04_q2" model="slide.question">
        <field name="question">Du kan läsa mejl men inte skicka. Vilket protokoll ska du kontrollera?</field>
        <field name="sequence">2</field>
        <field name="slide_id" ref="slide_mail_s1_04"/>
    </record>
    <record id="slide_mail_s1_04_q2_a1" model="slide.answer">
        <field name="text_value">IMAP</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — IMAP fungerar ju, eftersom du kan läsa.</field>
        <field name="question_id" ref="slide_mail_s1_04_q2"/>
    </record>
    <record id="slide_mail_s1_04_q2_a2" model="slide.answer">
        <field name="text_value">SMTP</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Utgående post går via SMTP — kontrollera server, port och lösenord.</field>
        <field name="question_id" ref="slide_mail_s1_04_q2"/>
    </record>
    <record id="slide_mail_s1_04_q2_a3" model="slide.answer">
        <field name="text_value">CardDAV</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — det är kontaktsynk, inte e-post.</field>
        <field name="question_id" ref="slide_mail_s1_04_q2"/>
    </record>

    <record id="slide_mail_s1_04_q3" model="slide.question">
        <field name="question">Varför är IMAP bättre än POP3 när du har flera enheter?</field>
        <field name="sequence">3</field>
        <field name="slide_id" ref="slide_mail_s1_04"/>
    </record>
    <record id="slide_mail_s1_04_q3_a1" model="slide.answer">
        <field name="text_value">Meddelandena ligger kvar på servern och syns i alla klienter</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Läser du i mobilen visas det som läst i datorn också.</field>
        <field name="question_id" ref="slide_mail_s1_04_q3"/>
    </record>
    <record id="slide_mail_s1_04_q3_a2" model="slide.answer">
        <field name="text_value">IMAP är snabbare</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — hastigheten är inte den avgörande skillnaden.</field>
        <field name="question_id" ref="slide_mail_s1_04_q3"/>
    </record>
    <record id="slide_mail_s1_04_q3_a3" model="slide.answer">
        <field name="text_value">IMAP krypterar meddelandena</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — krypteringen sköts av anslutningen (TLS), inte av protokollet i sig.</field>
        <field name="question_id" ref="slide_mail_s1_04_q3"/>
    </record>

