<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

    <!-- ═══════════════════════════════════════════════════════════════════
         SEKTION 3: Arbeta med e-posten
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="slide_category_mail_s3" model="slide.slide">
        <field name="name">3. Arbeta med e-posten</field>
        <field name="is_category" eval="True"/>
        <field name="channel_id" ref="user_mail_onboarding.slide_channel_user_mail"/>
        <field name="sequence">200</field>
    </record>

    <record id="slide_mail_s3_01" model="slide.slide">
        <field name="name">Mappar, sökning och bilagor</field>
        <field name="sequence">210</field>
        <field name="slide_category">article</field>
        <field name="channel_id" ref="user_mail_onboarding.slide_channel_user_mail"/>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="True"/>
        <field name="completion_time">0.30</field>
        <field name="html_content" type="html">
<section class="s_text_block pt64 pb40">
    <div class="container s_allow_columns">
        <h2>Mappar</h2>
        <p>Mappar fungerar som du är van vid — och eftersom de ligger på servern synkas de mellan alla dina klienter. Skapar du en mapp i Odoo dyker den upp i mobilen.</p>
        <p>Ett enkelt system som håller:</p>
        <table class="table table-bordered">
            <thead>
                <tr><th>Mapp</th><th>Innehåll</th></tr>
            </thead>
            <tbody>
                <tr><td><strong>Inkorgen</strong></td><td>Obearbetat. Töm den varje dag.</td></tr>
                <tr><td><strong>Att göra</strong></td><td>Mejl som kräver en handling av dig</td></tr>
                <tr><td><strong>Väntar</strong></td><td>Mejl där du väntar på svar från någon annan</td></tr>
                <tr><td><strong>Arkiv</strong></td><td>Avslutat men värt att spara</td></tr>
            </tbody>
        </table>
        <p class="small text-muted">Undvik djupa mapphierarkier. Det är svårt att hitta tillbaka och sökningen klarar jobbet bättre.</p>
    </div>
</section>

<section class="s_text_image pt32 pb64">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 pt16 pb16">
                <h2 class="h3-fs">Sökning slår mappar</h2>
                <p>Den vanligaste orsaken till att mappsystem kollapsar är att man inte minns var man la något. Sökningen löser det — förutsatt att du vet vad du söker efter.</p>
                <p>Sök på <strong>avsändare</strong>, <strong>ämne</strong>, <strong>datumintervall</strong> eller <strong>innehåll</strong>. Kombinera gärna.</p>
            </div>
            <div class="col-lg-6 pt16 pb16">
                <h2 class="h3-fs">Bilagor</h2>
                <p>Bilagor följer med meddelandet och kan öppnas direkt. I Odoo kan de också kopplas till en uppgift eller ett dokument, så att de hamnar där de hör hemma istället för att försvinna i inkorgen.</p>
                <p class="small text-muted">Tänk på att stora bilagor fyller brevlådan. Skicka länkar till dokument istället för kopior när det går.</p>
            </div>
        </div>
    </div>
</section>

<section class="s_call_to_action o_cc o_cc5 pt48 pb48">
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <h3>Koppla mejlet till arbetet</h3>
                <p class="lead">Det här är styrkan med e-post i Odoo: ett mejl från en kund kan knytas direkt till kundens post, en uppgift eller ett projekt. Då finns konversationen kvar där arbetet sker — inte i en inkorg någon glömmer bort.</p>
            </div>
        </div>
    </div>
</section>
        </field>
        <field name="description">Mappstruktur som håller, varför sökning slår mappar, och hur bilagor hanteras. Plus kopplingen mellan mejl och uppgifter i Odoo.</field>
    </record>

    <record id="slide_mail_s3_02" model="slide.slide">
        <field name="name">🧪 Testa dina kunskaper — Arbetet</field>
        <field name="sequence">220</field>
        <field name="slide_category">quiz</field>
        <field name="channel_id" ref="user_mail_onboarding.slide_channel_user_mail"/>
        <field name="is_published" eval="True"/>
        <field name="completion_time">0.25</field>
        <field name="quiz_first_attempt_reward">100</field>
        <field name="quiz_second_attempt_reward">75</field>
        <field name="quiz_third_attempt_reward">50</field>
        <field name="quiz_fourth_attempt_reward">25</field>
        <field name="description">Testa dina kunskaper om mappar, sökning och hur e-posten kopplas till arbetet i Odoo.</field>
    </record>

    <record id="slide_mail_s3_02_q1" model="slide.question">
        <field name="question">Du skapar en mapp i Odoo. Vad händer i mobilen?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_mail_s3_02"/>
    </record>
    <record id="slide_mail_s3_02_q1_a1" model="slide.answer">
        <field name="text_value">Ingenting — mappar är lokala per klient</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — mappar ligger på servern och synkas.</field>
        <field name="question_id" ref="slide_mail_s3_02_q1"/>
    </record>
    <record id="slide_mail_s3_02_q1_a2" model="slide.answer">
        <field name="text_value">Mappen dyker upp där också</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Med IMAP synkroniseras mappstrukturen mellan alla klienter.</field>
        <field name="question_id" ref="slide_mail_s3_02_q1"/>
    </record>
    <record id="slide_mail_s3_02_q1_a3" model="slide.answer">
        <field name="text_value">Du måste skapa den manuellt i mobilen</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — det är just det du slipper.</field>
        <field name="question_id" ref="slide_mail_s3_02_q1"/>
    </record>

    <record id="slide_mail_s3_02_q2" model="slide.question">
        <field name="question">Varför bör du undvika djupa mapphierarkier?</field>
        <field name="sequence">2</field>
        <field name="slide_id" ref="slide_mail_s3_02"/>
    </record>
    <record id="slide_mail_s3_02_q2_a1" model="slide.answer">
        <field name="text_value">De tar mer plats på servern</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — mappar tar ingen nämnvärd plats.</field>
        <field name="question_id" ref="slide_mail_s3_02_q2"/>
    </record>
    <record id="slide_mail_s3_02_q2_a2" model="slide.answer">
        <field name="text_value">Det blir svårt att minnas var man la något — sökningen gör jobbet bättre</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Få mappar och bra sökning slår ett komplicerat mappsystem.</field>
        <field name="question_id" ref="slide_mail_s3_02_q2"/>
    </record>
    <record id="slide_mail_s3_02_q2_a3" model="slide.answer">
        <field name="text_value">De synkas inte mellan enheter</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — de synkas, det är inte problemet.</field>
        <field name="question_id" ref="slide_mail_s3_02_q2"/>
    </record>

    <record id="slide_mail_s3_02_q3" model="slide.question">
        <field name="question">Vad är styrkan med e-post i Odoo jämfört med en fristående klient?</field>
        <field name="sequence">3</field>
        <field name="slide_id" ref="slide_mail_s3_02"/>
    </record>
    <record id="slide_mail_s3_02_q3_a1" model="slide.answer">
        <field name="text_value">Den är snabbare</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — hastigheten är inte poängen.</field>
        <field name="question_id" ref="slide_mail_s3_02_q3"/>
    </record>
    <record id="slide_mail_s3_02_q3_a2" model="slide.answer">
        <field name="text_value">Mejl kan kopplas till uppgifter, projekt och kunder</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Rätt! Konversationen hamnar där arbetet sker, istället för i en separat inkorg.</field>
        <field name="question_id" ref="slide_mail_s3_02_q3"/>
    </record>
    <record id="slide_mail_s3_02_q3_a3" model="slide.answer">
        <field name="text_value">Den har fler funktioner för bilagor</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Nej — det är kopplingen till arbetet som är den verkliga skillnaden.</field>
        <field name="question_id" ref="slide_mail_s3_02_q3"/>
    </record>

    </data>
</odoo>
